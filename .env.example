# ─────────────────────────────────────────────
#  FTB — Indian Startup Intelligence Platform
#  Copy this file to .env and fill in values
# ─────────────────────────────────────────────

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

EXCEL_OUTPUT_PATH=excel/Indian_Startup_Outreach.xlsx
LOG_FILE_PATH=logs/pipeline_execution.log
DB_PATH=data/ftb_store.db

SHEET_ID=15fuzMFlSj2zVaseYlMYdfRaFkmCeUoCyrvKxV6mxLis
GOOGLE_SERVICE_ACCOUNT_JSON=credentials.json
GOOGLE_SHEET_WORKSHEET=LinkedIn Hiring Leads
DRY_RUN=true

# ── Cold Outreach (app/outreach.py) ─────────────────────────────
# Nothing sends while DRY_RUN=true. Use run_cold_outreach.py --live
# or POST /outreach on a process where DRY_RUN=false.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-app-password
OUTREACH_FROM_EMAIL=your-address@gmail.com
OUTREACH_SENDER_NAME=Kartik
OUTREACH_MAX_PER_RUN=10

# ── LLM Quality Gate (app/llm/) ─────────────────────────────────
# Leave GROQ_API_KEY empty to disable the gate (everything -> Review).
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_DAY_OF_WEEK=sun
SCHEDULER_HOUR=1
SCHEDULER_MINUTE=0

PIPELINE_STARTUP_LIMIT=10
PIPELINE_JOB_SEARCH_DELAY=2
PIPELINE_SEARCH_DELAY=1.5

# ── Y Combinator Discovery ──────────────────────────────────────
SOURCE_Y_COMBINATOR=true
YC_RECENT_BATCHES=Fall 2026,Summer 2026,Spring 2026,Winter 2026,Fall 2025,Summer 2025,Spring 2025,Winter 2025
YC_REGIONS_FILTER=India,South Asia
YC_MAX_COMPANIES=300

# API_KEY=your-secret-api-key-here
# ALLOWED_ORIGINS=https://your-frontend.com
