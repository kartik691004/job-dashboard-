# ── Proximity Rule (spec §4) ──────────────────────────────────────────────────
# Role keyword and hiring signal must appear within this many characters.
# Confidence:  0–100 chars  → 1.0
#             101–300 chars  → 0.8
#             >300 chars     → no match
PROXIMITY_CHAR_LIMIT = int(os.getenv("HIRING_PROXIMITY_CHARS", "300"))

