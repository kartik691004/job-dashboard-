{
  "name": "FastAPI & AI Indian Startup Intelligence & Outreach Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "id": "node-cron-001",
      "name": "Daily Morning Trigger (9 AM)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [180, 300]
    },
    {
      "parameters": {
        "url": "http://fastapi-backend:8000/startups",
        "options": {
          "retry": {
            "retry": {
              "maxTries": 3,
              "waitBetweenTries": 1000
            }
          }
        }
      },
      "id": "node-discover-002",
      "name": "1. Fetch Discovered Indian Startups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [400, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://fastapi-backend:8000/run",
        "sendBody": false,
        "options": {
          "retry": {
            "retry": {
              "maxTries": 3
            }
          }
        }
      },
      "id": "node-pipeline-003",
      "name": "2. Run 8-Stage Pipeline & Generate Excel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [620, 300]
    },
    {
      "parameters": {
        "jsCode": "// Robust Data Sanitizer & Schema Validator for n8n\nconst items = $input.all();\nreturn items.map((item) => {\n  const data = item.json || {};\n  const metrics = data.metrics || {};\n  return {\n    json: {\n      workbookName: 'Indian_Startup_Outreach.xlsx',\n      sheets: ['Startups', 'Leadership', 'Hiring Contacts', 'Jobs', 'Investors', 'Funding History', 'AI Outreach', 'Logs'],\n      status: data.status || 'SUCCESS',\n      duration: data.execution_duration || '0.1 min',\n      companiesFound: metrics.companies_found || 0,\n      companiesAdded: metrics.companies_added || 0,\n      jobsFound: metrics.jobs_found || 0,\n      outreachSequences: metrics.outreach_sequences || 0,\n      excelFiles: metrics.excel_files || [],\n      executedAt: new Date().toISOString()\n    }\n  };\n});"
      },
      "id": "node-code-004",
      "name": "3. Data Sanitizer & 8-Sheet Validator",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [840, 300]
    },
    {
      "parameters": {
        "url": "http://fastapi-backend:8000/export",
        "options": {}
      },
      "id": "node-excel-005",
      "name": "4. Verify & Download Indian_Startup_Outreach.xlsx",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1060, 300]
    },
    {
      "parameters": {},
      "id": "node-error-006",
      "name": "Error Handler (Catch & Retry)",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [620, 520]
    }
  ],
  "connections": {
    "Daily Morning Trigger (9 AM)": {
      "main": [
        [
          {
            "node": "1. Fetch Discovered Indian Startups",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "1. Fetch Discovered Indian Startups": {
      "main": [
        [
          {
            "node": "2. Run 8-Stage Pipeline & Generate Excel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "2. Run 8-Stage Pipeline & Generate Excel": {
      "main": [
        [
          {
            "node": "3. Data Sanitizer & 8-Sheet Validator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "3. Data Sanitizer & 8-Sheet Validator": {
      "main": [
        [
          {
            "node": "4. Verify & Download Indian_Startup_Outreach.xlsx",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveDataErrorExecution": "all"
  },
  "tags": [
    "FastAPI",
    "Indian-Startup-Intelligence",
    "8-Sheet-Excel-Export",
    "Gemini-AI"
  ]
}
